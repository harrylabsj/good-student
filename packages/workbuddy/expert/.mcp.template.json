{
  "mcpServers": {
    "good-student": {
      "type": "stdio",
      "command": "python3",
      "args": ["${CODEBUDDY_PLUGIN_ROOT}/bin/start_mcp.py"],
      "cwd": "${CODEBUDDY_PLUGIN_ROOT}",
      "env": {"GOOD_STUDENT_RUNTIME": "${CODEBUDDY_PLUGIN_DATA}/runtime"},
      "timeout": 180000,
      "x-workbuddy": {
        "displayName": {
          "zh": "学生错题本本地工具",
          "en": "Student Wrong-book Local Tools"
        },
        "description": {
          "zh": "在本机保存、确认和分析错题，并生成学习计划与复测记录。",
          "en": "Store, confirm, and analyze wrong questions locally, then create plans and reassessments."
        },
        "icon": "./avatars/expert.png",
        "auth": {
          "type": "none"
        }
      }
    }
  }
}
